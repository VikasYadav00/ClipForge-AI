# ===========================================
# ClipForge AI - Environment Configuration
# ===========================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://clipforge:clipforge@localhost:5432/clipforge
DATABASE_URL_SYNC=postgresql://clipforge:clipforge@localhost:5432/clipforge

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT Authentication ---
JWT_SECRET=change-me-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI Providers ---
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=gemini
# Options: gemini, openai, demo

# --- Whisper ---
WHISPER_MODEL=base
# Options: tiny, base, small, medium, large

# --- SMTP (Email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@clipforge.ai

# --- Storage ---
STORAGE_PROVIDER=local
# Options: local, s3, r2

# S3 / R2 Configuration
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=clipforge
S3_ENDPOINT=
S3_REGION=auto

# --- Local Storage ---
UPLOAD_DIR=./storage/uploads
OUTPUT_DIR=./storage/output
TEMP_DIR=./storage/temp

# --- Upload Limits ---
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_MINUTES=120
ALLOWED_EXTENSIONS=mp4,mov,mkv,webm,avi

# --- Processing ---
MAX_CLIP_DURATION_SECONDS=30
MIN_CLIP_DURATION_SECONDS=10
DEFAULT_CLIPS_COUNT=10

# --- Application ---
APP_NAME=ClipForge AI
APP_ENV=development
# Options: development, production
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- Admin ---
ADMIN_EMAIL=admin@clipforge.ai
ADMIN_PASSWORD=change-me

# --- Google OAuth (Optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
